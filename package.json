{
  "name": "serp-scout",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered competitive intelligence and SEO platform for small businesses",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @serp-scout/db db:generate",
    "db:push": "pnpm --filter @serp-scout/db db:push",
    "db:studio": "pnpm --filter @serp-scout/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@10.6.1"
}
